{
  "name": "asm",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/dev.mjs",
    "build": "ng build",
    "export:lab1": "npm run build && node scripts/export-lab1.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:ASM": "node dist/ASM/server/server.mjs",
    "start:frontend": "ng serve",
    "start:api": "node --env-file-if-exists=.env server/index.mjs",
    "build:vercel": "ng build --configuration production,static",
    "test:api": "node --env-file-if-exists=.env --test server/app.test.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "mongodb": "^7.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
