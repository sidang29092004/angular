{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/ASM/browser",
  "functions": { "api/proxy.mjs": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/proxy?path=:path*" },
    { "source": "/((?!api(?:/|$)|assets(?:/|$)|media(?:/|$)|.*\\.[^/]+$).*)", "destination": "/index.html" }
  ]
}
